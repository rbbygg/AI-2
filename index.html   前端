```html
<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI 資訊分析工具</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 40px 20px;
            font-family: Arial, "Microsoft JhengHei", sans-serif;
            background: #f5f5f5;
            color: #222;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
        }

        h1 {
            text-align: center;
            margin-bottom: 30px;
        }

        textarea {
            width: 100%;
            min-height: 250px;
            padding: 15px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 16px;
            resize: vertical;
            background: white;
        }

        button {
            width: 100%;
            margin-top: 15px;
            padding: 14px;
            border: none;
            border-radius: 8px;
            background: #222;
            color: white;
            font-size: 16px;
            cursor: pointer;
        }

        button:hover {
            background: #444;
        }

        button:disabled {
            background: #999;
            cursor: not-allowed;
        }

        .result {
            margin-top: 25px;
            padding: 20px;
            min-height: 150px;
            background: white;
            border: 1px solid #ddd;
            border-radius: 8px;
            white-space: pre-wrap;
            line-height: 1.6;
        }
    </style>
</head>

<body>

    <div class="container">

        <h1>AI 資訊分析工具</h1>

        <textarea
            id="inputText"
            placeholder="請輸入你想分析的文字..."
        ></textarea>

        <button id="analyzeButton">
            開始分析
        </button>

        <div class="result" id="result">
            分析結果會顯示在這裡
        </div>

    </div>

    <script>
        const inputText = document.getElementById("inputText");
        const analyzeButton = document.getElementById("analyzeButton");
        const result = document.getElementById("result");

        analyzeButton.addEventListener("click", async () => {

            const text = inputText.value.trim();

            if (!text) {
                result.textContent = "請先輸入文字。";
                return;
            }

            analyzeButton.disabled = true;
            analyzeButton.textContent = "分析中...";
            result.textContent = "正在分析，請稍候...";

            try {

                const response = await fetch("/api/analyze", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        text: text
                    })
                });

                if (!response.ok) {
                    throw new Error("伺服器回應錯誤");
                }

                const data = await response.json();

                /*
                 * 預期後端回傳格式：
                 *
                 * {
                 *     "result": "這是 AI 的分析結果"
                 * }
                 */

                result.textContent = data.result || "沒有取得分析結果。";

            } catch (error) {

                console.error(error);

                result.textContent =
                    "分析失敗，請確認 /api/analyze 是否正常運作。";

            } finally {

                analyzeButton.disabled = false;
                analyzeButton.textContent = "開始分析";

            }
        });
    </script>

</body>
</html>
```
